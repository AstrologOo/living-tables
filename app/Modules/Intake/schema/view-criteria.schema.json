{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://graph.local/schema/view-criteria.schema.json",
  "title": "NodeView criteria (v1)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "filter": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["field", "cmp", "value"],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "cmp": { "enum": ["==", "!=", ">", "<", ">=", "<=", "contains"] },
          "value": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sort_field": { "type": "string", "minLength": 1 },
    "sort_order": { "enum": ["asc", "desc"] },
    "unique_field": { "type": "string", "minLength": 1 },
    "limit_count": { "type": "integer", "minimum": 1 }
  }
}
