APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Docker Compose: ports published on the host, and the image name. Change them to run a second copy of the stack
# (and give it its own COMPOSE_PROJECT_NAME).
# COMPOSE_PROJECT_NAME=living-tables
# APP_IMAGE=graph-backend-app:local
# FORWARD_APP_PORT=8080
# FORWARD_REVERB_PORT=8081
# FORWARD_DB_PORT=5432
# FORWARD_REDIS_PORT=6379
# FORWARD_RABBITMQ_PORT=5672
# FORWARD_RABBITMQ_UI_PORT=15672

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=graph_backend_app
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Lifetime of an API token, in minutes. Unset = 43200 (30 days).
# SANCTUM_TOKEN_EXPIRATION_MINUTES=43200

# Comma-separated frontend origin(s), e.g. http://localhost:5173. "*" is
# fine for local dev against an unknown/not-yet-deployed frontend — pin
# this to real origins in any shared/production environment.
CORS_ALLOWED_ORIGINS=*

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Server-side: the app container talks to Reverb over the docker network,
# by service name — not the host-published port a browser would use.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# Client-side (frontend build): the externally-reachable host/port a
# browser actually connects to — port 8081 (docker-compose publishes
# reverb's 8080 there, since 8080 is already nginx). Update per environment.
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8081
VITE_REVERB_SCHEME=http

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=app
RABBITMQ_PASSWORD=secret
RABBITMQ_VHOST=/

# Google AI Studio key, with billing enabled; without it phrases and llm steps are unavailable.
GEMINI_API_KEY=
GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite
GEMINI_MODEL_STANDARD=gemini-3.6-flash
GEMINI_MODEL_SMART=gemini-3.8-flash
# How long a model thinks. Without it the standard and smart models think at `medium`: slower, dearer (thinking
# tokens are billed as output) and closer to the 30 s request timeout. The default cheap and standard models accept
# minimal, low, medium, high; the smart one does not accept minimal.
GEMINI_THINKING_LEVEL=low

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
